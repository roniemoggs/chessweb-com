---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const homeUrl = translatePath('/');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
const learnHref = translatePath('/learn');
const piecesHref = `${learnHref}#pieces`;
const faqHref = isHome ? '#faq' : `${homeUrl}#faq`;
const onlineHref = translatePath('/online');
const aboutHref = translatePath('/about');
const contactHref = translatePath('/contact');
const privacyHref = translatePath('/privacy');
const termsHref = translatePath('/terms');
---

<footer class="w-full bg-[#fafafa] dark:bg-[#09090b] border-t border-[#ebebeb] dark:border-[#27272a] pt-12 pb-8 px-4 sm:px-6 select-none mt-20 text-[#8f8f8f] dark:text-[#71717a] transition-colors">
  <div class="max-w-6xl mx-auto space-y-10">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-[#ebebeb] dark:border-[#27272a]/60">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-3">
        <a href={homeUrl} class="inline-flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-serif text-lg font-bold shadow-xs group-hover:scale-105 transition-transform">
            ♚
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm sm:text-base text-[#171717] dark:text-white tracking-tight">
              {t('site.brand')}
              <span class="ml-1 text-[11px] font-mono font-medium text-[#8f8f8f] dark:text-[#71717a]">
                ({t('site.domain')})
              </span>
            </span>
          </div>
        </a>
        <p class="text-xs text-[#666666] dark:text-[#a1a1aa] max-w-sm leading-relaxed">
          {t('footer.desc')}
        </p>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white dark:bg-[#18181b] border border-[#ebebeb] dark:border-[#27272a] text-[11px] font-mono text-[#4d4d4d] dark:text-[#a1a1aa]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>{t('footer.engine')}</span>
        </div>
      </div>

      <!-- Column 1: Play & Learn -->
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white font-mono">
          {currentLang === 'ja' ? 'コンテンツ' : 'Navigation'}
        </p>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={homeUrl} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {currentLang === 'ja' ? '今すぐ対局 (AI対戦)' : 'Play vs Computer'}
            </a>
          </li>
          <li>
            <a href={onlineHref} class="hover:text-[#171717] dark:hover:text-white transition-colors inline-flex items-center gap-1.5">
              <span>{t('nav.online')}</span>
              <span class="text-[9px] px-1 py-0.2 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 rounded font-mono">P2P</span>
            </a>
          </li>
          <li>
            <a href={learnHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.learn')}
            </a>
          </li>
          <li>
            <a href={piecesHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.pieces')}
            </a>
          </li>
          <li>
            <a href={faqHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.faq')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Legal & About -->
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white font-mono">
          {currentLang === 'ja' ? 'サイト情報 & 規約' : 'About & Legal'}
        </p>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={aboutHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.about')}
            </a>
          </li>
          <li>
            <a href={contactHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.contact')}
            </a>
          </li>
          <li>
            <a href={privacyHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.privacy')}
            </a>
          </li>
          <li>
            <a href={termsHref} class="hover:text-[#171717] dark:hover:text-white transition-colors">
              {t('footer.terms')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
      <div class="flex items-center gap-4 flex-wrap justify-center sm:justify-start">
        <LanguagePicker />
        <button
          type="button"
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="hover:text-[#171717] dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1"
        >
          <span>↑</span>
          <span>{t('footer.backToTop')}</span>
        </button>
      </div>

      <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a] text-center sm:text-right font-mono">
        {t('footer.copyright')}
      </div>
    </div>
  </div>
</footer>
