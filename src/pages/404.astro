---
import Layout from '../layouts/Layout.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = 'ja';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  lang={lang}
  title={t('error.404.title')}
  description={t('error.404.desc')}
  noindex={true}
>
  <div class="relative min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-16 sm:py-24 overflow-hidden">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] sm:w-[650px] sm:h-[650px] bg-gradient-to-tr from-amber-500/15 via-orange-500/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/4 right-10 w-72 h-72 bg-blue-500/10 rounded-full blur-2xl pointer-events-none -z-10"></div>

    <div class="w-full max-w-2xl mx-auto text-center space-y-8 relative z-10">
      
      <!-- Visual Chess Emblem / Fallen King Animation -->
      <div class="relative inline-flex items-center justify-center">
        <!-- Background chessboard grid watermark -->
        <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-3xl bg-black/40 dark:bg-white/[0.03] border border-white/10 p-3 shadow-2xl backdrop-blur-md grid grid-cols-4 grid-rows-4 gap-1 transform -rotate-3 transition-transform hover:rotate-0 duration-300">
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
          <div class="bg-white/5 rounded-sm"></div>
          <div class="bg-white/10 rounded-sm"></div>
        </div>

        <!-- Overlaid Chess Piece (Tilted King) & Error Badge -->
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-6xl sm:text-7xl select-none filter drop-shadow-[0_10px_20px_rgba(245,158,11,0.35)] transform rotate-12 transition-transform hover:scale-110 duration-200 cursor-default">
            ♚
          </span>
        </div>

        <!-- Out of bounds tag -->
        <div class="absolute -bottom-3 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-600 dark:text-amber-400 font-mono text-[11px] font-bold tracking-wider backdrop-blur-md shadow-md uppercase">
          Illegal Move: i9
        </div>
      </div>

      <!-- Error Code & Headings -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/40 dark:bg-white/5 border border-white/10 text-xs font-mono text-[#8f8f8f] dark:text-[#a1a1aa]">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span>HTTP 404 NOT FOUND</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-[#171717] dark:text-white">
          キングが盤外に<br class="sm:hidden" />飛び出しました
        </h1>

        <p class="text-sm sm:text-base text-[#666666] dark:text-[#a1a1aa] max-w-lg mx-auto leading-relaxed">
          お探しのページ（局面）は、存在しないマスに移動したか、既に盤面から取り除かれています。チェス盤は a1 から h8 までの 64マスです。
        </p>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href={translatePath('/')}
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-black shadow-[0_4px_20px_rgba(245,158,11,0.3)] hover:shadow-[0_6px_25px_rgba(245,158,11,0.4)] transition-all flex items-center justify-center gap-2 active:scale-98"
        >
          <span>♔</span>
          <span>今すぐ対局に戻る</span>
        </a>

        <a
          href={translatePath('/learn')}
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm bg-white dark:bg-[#1a1a1e] hover:bg-[#f4f4f5] dark:hover:bg-[#27272a] text-[#171717] dark:text-white border border-[#e4e4e7] dark:border-[#27272a] transition-all flex items-center justify-center gap-2 active:scale-98"
        >
          <span>📖</span>
          <span>チェスのルールを学ぶ</span>
        </a>
      </div>

      <!-- Quick Helpful Links Grid -->
      <div class="pt-6 border-t border-[#e4e4e7] dark:border-white/10">
        <p class="text-xs font-mono text-[#8f8f8f] dark:text-[#71717a] mb-4">
          他の主要ページへ移動する
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 max-w-xl mx-auto text-xs">
          <a
            href={translatePath('/')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-amber-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-amber-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-amber-500">AI対戦</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">無料Stockfish</div>
          </a>
          <a
            href={translatePath('/online')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-amber-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-amber-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-amber-500">友達対戦</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">オンライン対局</div>
          </a>
          <a
            href={translatePath('/about')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-amber-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-amber-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-amber-500">運営について</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">サイト概要</div>
          </a>
          <a
            href={translatePath('/contact')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-amber-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-amber-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-amber-500">お問い合わせ</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">バグ報告・要望</div>
          </a>
        </div>
      </div>

      <!-- English version shortcut link -->
      <div class="text-xs text-[#8f8f8f] dark:text-[#71717a]">
        Looking for English? <a href="/en/404" class="text-amber-600 dark:text-amber-400 underline hover:opacity-80">View 404 page in English</a>
      </div>

    </div>
  </div>
</Layout>
