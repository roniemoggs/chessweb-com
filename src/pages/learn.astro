---
import Layout from '../layouts/Layout.astro';
import { LearnHub } from '../components/chess/LearnHub';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

const t = useTranslations('ja');
const translatePath = useTranslatedPath('ja');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  'name': 'チェスのルール・駒の動かし方 完全学習ガイド',
  'description': '初心者でもゼロからわかるチェス学習ページ。動かして試せるインタラクティブ盤面、全6駒の動かし方・点数・戦術、キャスリング等の特殊ルール、チェックメイトの基本から確認クイズまで徹底解説。',
  'learningResourceType': 'Guide',
  'educationalLevel': 'Beginner',
  'inLanguage': 'ja',
};
---

<Layout
  lang="ja"
  title={t('learn.metaTitle')}
  description={t('learn.metaDesc')}
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14 space-y-12">
    <!-- Hero / Header -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 text-xs font-mono font-bold shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>初心者大歓迎 • ルールをゼロから学べる</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#171717] dark:text-white tracking-tight leading-tight">
        チェスのルール・駒の動かし方<br class="hidden sm:block" />
        <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 bg-clip-text text-transparent">完全学習ガイド</span>
      </h1>
      <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1aa] max-w-2xl mx-auto leading-relaxed">
        チェスを全く知らない初心者でも大丈夫！盤面の並べ方、全6種類の駒の動かし方・点数、キャスリング等の特殊手、チェックメイトの基本から確認クイズまで、実際に駒を動かしながら楽しくマスターできます。
      </p>
    </header>

    <!-- Comprehensive Interactive Learning Hub -->
    <LearnHub client:only="react" lang="ja" />
  </div>
</Layout>
