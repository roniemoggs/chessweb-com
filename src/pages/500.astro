---
import Layout from '../layouts/Layout.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = 'ja';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  lang={lang}
  title={t('error.500.title')}
  description={t('error.500.desc')}
  noindex={true}
>
  <div class="relative min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-16 sm:py-24 overflow-hidden">
    <!-- Ambient glowing backgrounds (Red/Amber alert tones) -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] sm:w-[650px] sm:h-[650px] bg-gradient-to-tr from-rose-500/15 via-amber-500/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute bottom-1/4 left-10 w-72 h-72 bg-orange-500/10 rounded-full blur-2xl pointer-events-none -z-10"></div>

    <div class="w-full max-w-2xl mx-auto text-center space-y-8 relative z-10">
      
      <!-- Visual Chess / Engine Overheat Emblem -->
      <div class="relative inline-flex items-center justify-center">
        <!-- Background evaluation / server chip card -->
        <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-3xl bg-black/40 dark:bg-white/[0.03] border border-red-500/20 p-3 shadow-2xl backdrop-blur-md flex flex-col items-center justify-center relative overflow-hidden group">
          <!-- Subtle warning pulse rings -->
          <div class="absolute inset-0 bg-red-500/5 animate-pulse rounded-3xl"></div>
          
          <!-- Mini evaluation bar graphic -->
          <div class="w-20 h-1.5 rounded-full bg-white/10 overflow-hidden mb-2">
            <div class="w-1/2 h-full bg-gradient-to-r from-red-500 to-amber-500 animate-[pulse_1.5s_ease-in-out_infinite]"></div>
          </div>

          <!-- Overlaid Chess Piece (Rook / Knight) -->
          <span class="text-5xl sm:text-6xl select-none filter drop-shadow-[0_10px_20px_rgba(239,68,68,0.35)] transition-transform group-hover:scale-110 duration-200 cursor-default">
            ♜
          </span>
        </div>

        <!-- Engine warning badge -->
        <div class="absolute -bottom-3 px-3 py-1 rounded-full bg-red-500/20 border border-red-500/40 text-red-600 dark:text-red-400 font-mono text-[11px] font-bold tracking-wider backdrop-blur-md shadow-md uppercase flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
          Engine Stalled: 500
        </div>
      </div>

      <!-- Error Code & Headings -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/40 dark:bg-white/5 border border-white/10 text-xs font-mono text-[#8f8f8f] dark:text-[#a1a1aa]">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          <span>HTTP 500 INTERNAL SERVER ERROR</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-[#171717] dark:text-white">
          局面の計算中に<br class="sm:hidden" />エラーが発生しました
        </h1>

        <p class="text-sm sm:text-base text-[#666666] dark:text-[#a1a1aa] max-w-lg mx-auto leading-relaxed">
          サーバーまたは思考エンジンの演算処理で予期せぬトラブルが発生しました。ページを再読み込みするか、しばらく時間を置いてから再度お試しください。
        </p>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="reload-btn"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-500 hover:to-amber-500 text-white shadow-[0_4px_20px_rgba(239,68,68,0.3)] hover:shadow-[0_6px_25px_rgba(239,68,68,0.4)] transition-all flex items-center justify-center gap-2 active:scale-98 cursor-pointer"
        >
          <span>⟳</span>
          <span>ページを再読み込み</span>
        </button>

        <a
          href={translatePath('/')}
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm bg-white dark:bg-[#1a1a1e] hover:bg-[#f4f4f5] dark:hover:bg-[#27272a] text-[#171717] dark:text-white border border-[#e4e4e7] dark:border-[#27272a] transition-all flex items-center justify-center gap-2 active:scale-98"
        >
          <span>♔</span>
          <span>トップページへ戻る</span>
        </a>

        <a
          href={translatePath('/contact')}
          class="w-full sm:w-auto px-5 py-3.5 rounded-xl font-bold text-sm bg-transparent hover:bg-black/5 dark:hover:bg-white/5 text-[#666666] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all flex items-center justify-center gap-2 active:scale-98"
        >
          <span>✉</span>
          <span>不具合を報告</span>
        </a>
      </div>

      <!-- Quick Helpful Links Grid -->
      <div class="pt-6 border-t border-[#e4e4e7] dark:border-white/10">
        <p class="text-xs font-mono text-[#8f8f8f] dark:text-[#71717a] mb-4">
          他のページや機能へ移動する
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 max-w-xl mx-auto text-xs">
          <a
            href={translatePath('/')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-red-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-red-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-red-500">AI対局</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">無料プレイ</div>
          </a>
          <a
            href={translatePath('/learn')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-red-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-red-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-red-500">ルール解説</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">初心者ガイド</div>
          </a>
          <a
            href={translatePath('/online')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-red-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-red-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-red-500">友達対戦</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">オンライン対局</div>
          </a>
          <a
            href={translatePath('/contact')}
            class="p-3 rounded-xl bg-[#f4f4f5] dark:bg-[#111113] hover:bg-red-500/10 border border-[#e4e4e7] dark:border-[#222226] hover:border-red-500/30 text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all text-center group"
          >
            <div class="font-bold text-[#171717] dark:text-white mb-0.5 group-hover:text-red-500">サポート窓口</div>
            <div class="text-[11px] text-[#8f8f8f] dark:text-[#71717a]">お問い合わせ</div>
          </a>
        </div>
      </div>

      <!-- English version shortcut link -->
      <div class="text-xs text-[#8f8f8f] dark:text-[#71717a]">
        Looking for English? <a href="/en/500" class="text-amber-600 dark:text-amber-400 underline hover:opacity-80">View 500 error page in English</a>
      </div>

    </div>
  </div>

  <script is:inline>
    const reloadBtn = document.getElementById('reload-btn');
    if (reloadBtn) {
      reloadBtn.addEventListener('click', () => {
        window.location.reload();
      });
    }
  </script>
</Layout>
